[worldserver]

########################################
# mod-dungeon-difficulties: heroic creature spell scaling (dungeon difficulties E2)
########################################
#
#    DungeonDifficulties.Enable
#        Description: Scale stock creature spells on the heroic dungeons in DungeonDifficulties.Heroic.Maps so each
#                     hit takes the same share of a player's health as the creature's normal version does (see the
#                     README, "The rule"). Creature heals on creatures scale by the target's heroic / normal health.
#        Default:     1 - Enabled
#                     0 - Disabled
#

DungeonDifficulties.Enable = 1

#
#    DungeonDifficulties.Heroic.Maps
#        Description: Map ids (spaces or commas) whose heroic difficulty the rule acts on. Add a dungeon once its
#                     heroic templates exist (dbc-tools heroic declarations); normal difficulty is never touched.
#        Example:     "36 33 289 329 229 230 189 389 209"
#        Default:     "36" - Deadmines (the code's fallback for a missing or malformed value)
#                     This file ships "36 33 289 329 229 230 189 389 209": Deadmines, Shadowfang Keep, Scholomance,
#                     Stratholme, Blackrock Spire (a 10-player heroic row; Flex.Maps below scales it), Blackrock
#                     Depths, Scarlet Monastery, Ragefire Chasm and Zul'Farrak (5-player heroic rows, not flex).
#

DungeonDifficulties.Heroic.Maps = "36 33 289 329 229 230 189 389 209"

#
#    DungeonDifficulties.ReferenceHealth
#        Description: Reference health rows "<level>[tier]:<nonTank>:<tank>", the same format as
#                     BossMechanics.ReferenceHealth.Rows and the same rows WITHOUT row 16: when pasting that string
#                     here, drop "16:1100:1080" (it would move Deadmines' level 17 to 19 heroic stock spells, which
#                     read the first row, level 20). The rule reads the non-tank column: the heroic (h) row at the
#                     caster's level over the normal row at the caster's normal level. Without an "h" row heroic
#                     reads the normal rows by level. A malformed value logs a warning and uses the default.
#        Default:     "20:1300:1290 60:3670:3710 60h:4120:4110" - the E3 measurement (2026-11-05)
#                     This file ships BossMechanics.ReferenceHealth.Rows without row 16 (the REF
#                     rows 35 / 40 and the Blackrock Depths rows 52-56): a heroic stock spell of a level 35-40 caster
#                     reads its own normal row instead of the 20-60 line (about 7-8% under at 35 / 40).
#

DungeonDifficulties.ReferenceHealth = "20:1300:1290 35:2038:2072 40:2278:2307 52:3032:3126 53:3182:3266 55:3362:3629 56:3456:3727 60:3670:3710 60h:4120:4110"

#
#    DungeonDifficulties.Heroic.SpellExceptions
#        Description: Stock spell ids (spaces or commas) the rule leaves unscaled on heroic: their heroic value is
#                     whatever the engine computes at the heroic creature's level. Matches the cast id or, for a
#                     SpellDifficulty swap, the normal spell it came from. Spells from 200000 up (dbc-tools
#                     custom spells, boss mechanics) are never scaled and need no entry.
#        Example:     "5208 6304"
#        Default:     ""
#

DungeonDifficulties.Heroic.SpellExceptions = ""

#
#    DungeonDifficulties.Heroic.RequireHeroicTemplate
#        Description: Scale only casters running a heroic difficulty template (their current template entry differs
#                     from the normal entry). A creature without one (missed by the heroic generator) keeps its stock
#                     spells, matching its stock melee. 0 scales every non-player-controlled creature on the map
#                     (playtest switch; triggers without heroic templates then scale too).
#        Default:     1 - Enabled
#                     0 - Disabled
#

DungeonDifficulties.Heroic.RequireHeroicTemplate = 1

#
#    DungeonDifficulties.Debug
#        Description: Log every scaled hit (caster, spell, amount before and after, F) to module.dungeondifficulties.
#                     Noisy: playtests only.
#        Default:     0 - Disabled
#                     1 - Enabled
#

DungeonDifficulties.Debug = 0

########################################
# mod-dungeon-difficulties: the flex 5-10 scaler (Blackrock Spire build, spec rulings 6-14 and 20)
########################################
#
#    DungeonDifficulties.Flex.Enable
#        Description: Hold a player count at each pull on the maps in DungeonDifficulties.Flex.Maps and scale the
#                     pulled creature's max health by the ladder (see the README, "Flex scaler"). Every hostile
#                     creature (trash, bosses, adds) is held at its own pull; evade restores its base health. Damage
#                     never scales. Boss scripts read the held count for target counts, loot and taunt swaps.
#        Default:     1 - Enabled
#                     0 - Disabled (no holds; the API returns the 5-player values)
#

DungeonDifficulties.Flex.Enable = 1

#
#    DungeonDifficulties.Flex.Maps
#        Description: Map ids (spaces or commas) that are flex dungeons, every difficulty. Each one must also be off
#                     AutoBalance: AutoBalance.Disable.PerInstance (comma separated) in AutoBalance.conf, or both
#                     scalers stack (the module logs a warning at startup when one is missing).
#        Example:     "229"
#        Default:     "" - none (the code's fallback for a missing or malformed value)
#                     This file ships "229": Lower and Upper Blackrock Spire.
#

DungeonDifficulties.Flex.Maps = "229"

#
#    DungeonDifficulties.Flex.MinPlayers
#    DungeonDifficulties.Flex.MaxPlayers
#        Description: The clamp on the counted players, for health, target counts and loot: fewer play the
#                     MinPlayers fight, more play the MaxPlayers fight. 1-40, MinPlayers <= MaxPlayers; otherwise
#                     a warning and the defaults. The rules keep their own break points (targets double at 6, loot
#                     one item per 5, tank swaps at 10).
#                     mod-dungeon-bosses' boss rules (target counts, loot rolls, taunt swaps) clamp the held count
#                     to 5-10 themselves (its kit_flex_parity_test pins these defaults): with other values here,
#                     health follows this clamp but the bosses' mechanics still play 5-10. Change them for a test
#                     only.
#        Default:     5, 10
#

DungeonDifficulties.Flex.MinPlayers = 5
DungeonDifficulties.Flex.MaxPlayers = 10

#
#    DungeonDifficulties.Flex.HealthStep
#        Description: Health multiplier per player above 5: max health = base x (1 + step x (count - 5)), so 0.25
#                     gives 1.00, 1.25, 1.50, 1.75, 2.00 and 2.25 for 5 to 10 players. 0-2. mod-dungeon-bosses'
#                     kit assumes 0.25 for its own health previews (see MinPlayers above).
#        Default:     0.25
#

DungeonDifficulties.Flex.HealthStep = 0.25

#
#    DungeonDifficulties.Flex.Debug
#        Description: Log every hold and release (trash included) to module.dungeondifficulties. Boss pulls are
#                     always logged (count, its source, players, health before and after).
#        Default:     0 - Disabled
#                     1 - Enabled
#

DungeonDifficulties.Flex.Debug = 0
